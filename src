local sitOnVehicleEnabled = false
local currentVehicleTarget = nil

local function getNearestVehicleSeat()
    local nearest = nil
    local minDist = math.huge
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    local searchArea = vehiclesFolder and vehiclesFolder:GetDescendants() or Workspace:GetDescendants()

    for _, desc in pairs(searchArea) do
        if desc:IsA("VehicleSeat") then
            local dist = (desc.Position - myPos).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = desc
            end
        end
    end
    return nearest
end

VehicleGroup:AddToggle("SitOnVehicleToggle", { Text = "Sit on Nearest Vehicle", Default = false, Callback = function(v) 
    sitOnVehicleEnabled = v
    if v then
        currentVehicleTarget = getNearestVehicleSeat()
    else
        currentVehicleTarget = nil
    end
end })

RunService.RenderStepped:Connect(function()
    if sitOnVehicleEnabled and currentVehicleTarget and currentVehicleTarget.Parent then
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            -- Position on the roof (approx 6 studs above the seat)
            LP.Character.HumanoidRootPart.CFrame = currentVehicleTarget.CFrame * CFrame.new(0, 6, 0)
            LP.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            LP.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    elseif sitOnVehicleEnabled and (not currentVehicleTarget or not currentVehicleTarget.Parent) then
        currentVehicleTarget = getNearestVehicleSeat()
    end
end)

-- Misc Tab / Emotes Logic
local EmoteGroup = Tabs["Misc"]:AddLeftGroupbox("Emotes", "smile")

local foundAnimations = {}
local animationNames = {"None"}
local selectedEmoteName = nil
local currentEmoteTrack = nil

local function refreshEmotes()
    foundAnimations = {}
    animationNames = {"None"}
    
    local function scanForAnimations(parent)
        for _, obj in pairs(parent:GetDescendants()) do
            if obj:IsA("Animation") and obj.AnimationId and obj.AnimationId ~= "" then
                local name = obj.Name
                -- Prevent duplicates
                if not foundAnimations[name] then
                    foundAnimations[name] = obj
                    table.insert(animationNames, name)
                end
            end
        end
    end
    
    -- Scan ReplicatedStorage and Workspace for animations
    scanForAnimations(ReplicatedStorage)
    scanForAnimations(Workspace)
    
    table.sort(animationNames)
end

-- Initial scan
refreshEmotes()

local EmoteDropdown = EmoteGroup:AddDropdown("EmoteDropdown", {
    Values = animationNames,
    Default = 1,
    Multi = false,
    Text = "Select Emote",
    Callback = function(Value)
        selectedEmoteName = Value
    end
})

EmoteGroup:AddButton("Refresh Emotes", function()
    refreshEmotes()
    EmoteDropdown:SetValues(animationNames)
end)

EmoteGroup:AddButton("Play Emote", function()
    if selectedEmoteName and selectedEmoteName ~= "None" and foundAnimations[selectedEmoteName] then
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
                
                -- Stop currently playing track if exists
                if currentEmoteTrack then
                    currentEmoteTrack:Stop()
                end
                
                -- Load and play the new track
                local success, track = pcall(function()
                    return animator:LoadAnimation(foundAnimations[selectedEmoteName])
                end)
                
                if success and track then
                    currentEmoteTrack = track
                    currentEmoteTrack:Play()
                end
            end
        end
    end
end)

EmoteGroup:AddButton("Stop Emote", function()
    if currentEmoteTrack then
        currentEmoteTrack:Stop()
        currentEmoteTrack = nil
    end
end)

