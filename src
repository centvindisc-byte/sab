-- Jump ESP Logic
local jumpESPEnabled = false
local jumpHighlights = {}

local function applyJumpESP(player)
    local function onCharacterAdded(char)
        if not jumpHighlights[player] then
            local hl = Instance.new("Highlight")
            hl.Name = "JumpESP"
            hl.FillTransparency = 1
            hl.OutlineColor = Color3.fromRGB(255, 255, 0)
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Enabled = false
            jumpHighlights[player] = hl
        end
        
        jumpHighlights[player].Parent = char
        
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            hum.StateChanged:Connect(function(old, new)
                if not jumpESPEnabled then 
                    if jumpHighlights[player] then jumpHighlights[player].Enabled = false end
                    return 
                end
                if new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall then
                    if jumpHighlights[player] then jumpHighlights[player].Enabled = true end
                else
                    if jumpHighlights[player] then jumpHighlights[player].Enabled = false end
                end
            end)
        end
    end
    
    if player.Character then
        onCharacterAdded(player.Character)
    end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, player in ipairs(Players:GetPlayers()) do
    applyJumpESP(player)
end
Players.PlayerAdded:Connect(applyJumpESP)

Players.PlayerRemoving:Connect(function(player)
    if jumpHighlights[player] then
        jumpHighlights[player]:Destroy()
        jumpHighlights[player] = nil
    end
end)

ESPGroup:AddToggle("JumpESPToggle", { Text = "Jump ESP", Default = false, Callback = function(v) 
    jumpESPEnabled = v
    if not v then
        for _, hl in pairs(jumpHighlights) do
            hl.Enabled = false
        end
    end
end })

-- Player ESP Logic
local playerESPEnabled = false
local playerHighlights = {}

local function applyPlayerESP(player)
    if player == LP then return end
    local char = player.Character
    if not char then return end
    
    if not playerHighlights[player] then
        local hl = Instance.new("Highlight")
        hl.Name = "PlayerESP"
        hl.FillTransparency = 0.7
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        playerHighlights[player] = hl
    end
    
    playerHighlights[player].Parent = char
    playerHighlights[player].Enabled = playerESPEnabled
end

local function removePlayerESP(player)
    if playerHighlights[player] then
        playerHighlights[player]:Destroy()
        playerHighlights[player] = nil
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if playerESPEnabled then applyPlayerESP(player) end
    end)
end)

Players.PlayerRemoving:Connect(removePlayerESP)

for _, player in ipairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if playerESPEnabled then applyPlayerESP(player) end
    end)
end

ESPGroup:AddToggle("PlayerESPToggle", { Text = "Player ESP", Default = false, Callback = function(v) 
